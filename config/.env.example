# Runtime/CI secret names only. Never commit real values.
# Offline projects do not need backend/storage/support secrets unless a later
# project explicitly enables the corresponding capability.

# AI providers used by the model router
GEMINI_API_KEY=
NVIDIA_API_KEY=
NARAROUTER_API_KEY=
HF_TOKEN=
Z_AI_API_KEY=

# Optional online-project backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional large-file/object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Optional Google Drive automation credential
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Optional support-mail OAuth identity (never store the Gmail password)
SUPPORT_GMAIL_ADDRESS=
SUPPORT_GMAIL_REFRESH_TOKEN=
