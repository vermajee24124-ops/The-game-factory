[application]
config/name="Turbo Rush"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.063, 0.125, 1)

[display/window]
size/viewport_width=1920
size/viewport_height=1080
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

[autoload]
GameConfig="*res://autoload/GameConfig.gd"
EventBus="*res://autoload/EventBus.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
EconomyService="*res://autoload/EconomyService.gd"
ProgressionService="*res://autoload/ProgressionService.gd"
RewardService="*res://autoload/RewardService.gd"
DifficultyService="*res://autoload/DifficultyService.gd"
LevelGenerator="*res://autoload/LevelGenerator.gd"
RaceSession="*res://autoload/RaceSession.gd"
AdsManager="*res://autoload/AdsManager.gd"
IAPManager="*res://autoload/IAPManager.gd"
AudioSystem="*res://autoload/AudioSystem.gd"
HapticsSystem="*res://autoload/HapticsSystem.gd"
ObjectPoolManager="*res://autoload/ObjectPoolManager.gd"

[layer_names]
3d_physics/layer_1="Track"
3d_physics/layer_2="Player"
3d_physics/layer_3="AI"
3d_physics/layer_4="Traffic"
3d_physics/layer_5="Obstacles"
3d_physics/layer_6="Pickups"
3d_physics/layer_7="Triggers"
