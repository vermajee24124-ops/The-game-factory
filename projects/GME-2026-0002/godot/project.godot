; Engine configuration file.
; Pocket Board 3D is fully offline and uses no backend/runtime network services.
config_version=5

[application]
config/name="Pocket Board 3D"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=960
size/window_height_override=540
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.035, 0.025, 1)

[physics]
3d/default_gravity=9.8

[input]
reset_game={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
new_round={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":78)]}
